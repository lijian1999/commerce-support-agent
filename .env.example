# ---- 模型（OpenAI 兼容接口，DGX Spark）----
# 每个角色可以单独配 <ROLE>_BASE_URL / <ROLE>_MODEL（ROLE = ROUTER / PLANNER / SQL_PLANNER / ANSWER / JUDGE），
# 没配的回落到 DEFAULT_*。备用模型同理：<ROLE>_FALLBACK_BASE_URL / <ROLE>_FALLBACK_MODEL，回落到 DEFAULT_FALLBACK_*。
DEFAULT_BASE_URL=http://192.168.1.114:8000/v1
DEFAULT_MODEL=Qwen/Qwen3.8-Flash-Next
DEFAULT_API_KEY=EMPTY
DEFAULT_FALLBACK_BASE_URL=http://192.168.1.114:8000/v1
DEFAULT_FALLBACK_MODEL=Qwen/Qwen3.8-Flash-Next

# ---- Embedding ----
EMBED_BASE_URL=http://192.168.1.114:8001/v1
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# ---- MySQL（docker compose 起的本地开发库，端口 3307）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=techhub
MYSQL_ROOT_PASSWORD=csa_root_dev
MYSQL_RO_USER=agent_ro
MYSQL_RO_PASSWORD=csa_ro_dev
MYSQL_RW_USER=agent_rw
MYSQL_RW_PASSWORD=csa_rw_dev

# ---- LangSmith（API Key 留空时自动关闭追踪）----
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=commerce-support-agent
